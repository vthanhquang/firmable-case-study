# Keep LF everywhere: outputs are compared byte-for-byte on reproduction, and Python writes LF.
* text=auto eol=lf
*.png binary
*.xlsx binary
*.zip binary
*.gz binary
*.pdf binary
*.woff2 binary
# Archived evidence has byte-bound hashes. Preserve publisher/recorder line endings.
outputs/** -text -whitespace
runs/** -text -whitespace
config/maintenance/** -text -whitespace
frontend/public/inter-OFL.txt -whitespace
