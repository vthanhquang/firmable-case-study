# Reference only: export variables in your terminal; the CLI does not load .env.
# No credentials are needed for the frozen replay, tests, reports or website.
DEEPSEEK_API_KEY=replace-with-your-own-key
FIRMABLE_BASE_URL=https://api.deepseek.com
FIRMABLE_MODEL=deepseek-flash
FIRMABLE_CRITIC_MODEL=deepseek-flash
# FIRMABLE_KEY_VAR=DEEPSEEK_API_KEY
# FIRMABLE_TOKEN_BUDGET=350000
# FIRMABLE_TOTAL_TOKEN_BUDGET=1000000
# Keep new live runs separate from historical accounting:
# FIRMABLE_USAGE_LEDGER=outputs/experiments/new-run/usage.jsonl
# FIRMABLE_BILLING_LEDGER=outputs/experiments/new-run/balance.jsonl
