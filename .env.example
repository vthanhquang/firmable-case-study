# MiraiAPI (OpenAI-compatible) key. The variable NAME is configurable:
MIRAI_API_KEY=sk-...
# FIRMABLE_KEY_VAR=MIRAI_API_KEY        # which env var holds the key
# FIRMABLE_MODEL=deepseek-v4-flash       # agent model
# FIRMABLE_CRITIC_MODEL=deepseek-v4-flash
# FIRMABLE_TOKEN_BUDGET=6000000          # hard stop across all runs
