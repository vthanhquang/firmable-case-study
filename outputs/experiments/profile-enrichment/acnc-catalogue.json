  "organization": {
    "id": "4d907503-b2aa-4c38-ac13-1273e791cb08",
    "name": "acnc",
    "title": "Australian Charities and Not-for-profits Commission (ACNC)",
    "type": "organization",
    "description": "The ACNC is the national regulator of charities and was established in December 2012 to achieve the following objects:\r\n\r\n- maintain, protect and enhance public trust and confidence in the sector \r\n- support and sustain a robust, vibrant, independent and innovative not-for-profit sector\r\n- promote the reduction of unnecessary regulatory obligations on the sector.\r\n\r\n## NOTE: \r\n\r\nIf you would like to confirm if an organisation is registered as a charity, or if you would like to view more information on individual charities, please use the [ACNC Charity Register](https://www.acnc.gov.au/charity).",
